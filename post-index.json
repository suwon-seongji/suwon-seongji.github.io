---
layout: null
permalink: /post-index.json
sitemap: false
---
{"site":{{ site.url | jsonify }},"posts":[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"url":{{ post.url | absolute_url | jsonify }},"date":{{ post.date | date: '%Y-%m-%d' | jsonify }},"topic_id":{{ post.topic_id | jsonify }},"keywords":{{ post.keywords | jsonify }},"summary":{{ post.summary | jsonify }},"text":{{ post.content | strip_html | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}
